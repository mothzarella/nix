# https://gitgud.io/aeroshell/uac-polkit-agent/-/blob/master/add_rule.sh
# https://invent.kde.org/plasma/kwin/-/blob/master/src/rules.h

[General][$i]
count=3
rules=capture-bridge,force-ssd,no-minimize-polkit

[capture-bridge][$i]
Description=Hide the xwayland capture bridge
Enabled=true
wmclass=xwaylandvideobridge
wmclassmatch=2
noborder=true
noborderrule=2
acceptfocus=false
acceptfocusrule=2
below=true
belowrule=2
skippager=true
skippagerrule=2
skipswitcher=true
skipswitcherrule=2
skiptaskbar=true
skiptaskbarrule=2

[force-ssd][$i]
Description=Force server-side decorations on all windows
Enabled=true
wmclassmatch=0
noborder=false
noborderrule=2

[no-minimize-polkit][$i]
Description=Keep the UAC authentication dialog off the taskbar
Enabled=true
clientmachine=localhost
minimize=false
minimizerule=2
wmclass=(polkit-kde-authentication-agent-1)|(uac-polkit-manager)|(org.kde.polkit-kde-authentication-agent-1)
wmclassmatch=3
